{
  "name": "@catalystcommunity/zest",
  "version": "0.3.12",
  "description": "Library of separated standard web-components, tools, and helper libs for everywhere to enjoy, even in frameworks if preferred.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/index.js",
    "src/index.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "ZEST_E2E_BROWSERS=chromium,firefox,webkit playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "build:packages": "npm run build --workspaces",
    "e2e:install": "playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catalystcommunity/zest.git"
  },
  "keywords": [
    "webcomponents",
    "vanilla",
    "minimalist",
    "agnostic"
  ],
  "author": "Catalyst Squad <opensource@catalystcommunity.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/catalystcommunity/zest/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/catalystcommunity/zest#README.md",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@catalystcommunity/actions": ">=0.1.1 <1.0.0",
    "@catalystcommunity/base-components": ">=0.2.6 <1.0.0",
    "@catalystcommunity/basic-data-registry": ">=0.1.1 <1.0.0",
    "@catalystcommunity/basic-data-service": ">=0.2.6 <1.0.0",
    "@catalystcommunity/calendar-view": ">=0.1.1 <1.0.0",
    "@catalystcommunity/containers": ">=0.1.1 <1.0.0",
    "@catalystcommunity/controls": ">=0.1.1 <1.0.0",
    "@catalystcommunity/data-views": ">=0.1.1 <1.0.0",
    "@catalystcommunity/date-model": ">=0.1.1 <1.0.0",
    "@catalystcommunity/date-time-picker": ">=0.2.6 <1.0.0",
    "@catalystcommunity/design-tokens": ">=0.1.1 <1.0.0",
    "@catalystcommunity/event-broker": ">=0.3.5 <1.0.0",
    "@catalystcommunity/media": ">=0.1.1 <1.0.0",
    "@catalystcommunity/menu-gutter": ">=0.2.4 <1.0.0",
    "@catalystcommunity/menu-item": ">=0.1.5 <1.0.0",
    "@catalystcommunity/menu-logo": ">=0.1.5 <1.0.0",
    "@catalystcommunity/menus": ">=0.1.1 <1.0.0",
    "@catalystcommunity/simple-router": ">=0.1.2 <1.0.0",
    "@catalystcommunity/spreadsheet": ">=0.1.1 <1.0.0",
    "@catalystcommunity/two-tier-menu": ">=0.2.4 <1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
